# Copy this file to config.env and fill in your values

# Server port
PORT=4000

# Local file storage
UPLOADS_DIR=./uploads
SERVER_URL=http://localhost:4000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/myapp

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d

# Cookie
COOKIE_EXPIRE=5

# SMTP Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SERVICE=gmail
SMTP_MAIL=your@email.com
SMTP_PASSWORD=your_password

# Node environment
NODE_ENV=development

# Mock payments for testing (set true to skip real payment gateway)
PAYMENTS_MOCK=true

# Cron secret (for protected cron endpoints)
CRON_SECRET=generate_with_openssl_rand_hex_24
